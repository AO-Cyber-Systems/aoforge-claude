{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aoforge.aocyber.ai/schemas/verify-result/v1",
  "schema_version": 1,
  "title": "Stack pack verify result v1",
  "description": "What a stack pack's verify command prints on stdout (docs/PROPOSAL-stack-packs.md §5A.4). Exit 0 pass, 1 findings, 2 setup problem. Core merges results across packs: the merged status is the worst one, error > missing > fail > pass, and missing never counts as pass.",
  "type": "object",
  "required": ["status"],
  "properties": {
    "status": { "type": "string", "enum": ["pass", "fail", "missing", "error"] },
    "scope": { "type": "string", "enum": ["changed", "all"] },
    "summary": { "type": "string" },
    "install_hint": { "type": "string" },
    "truncated": { "type": "boolean" },
    "steps": {
      "type": "array",
      "items": {
        "type": "object", "required": ["name", "status"],
        "properties": { "name": { "type": "string" }, "status": { "type": "string", "enum": ["pass", "fail", "missing", "error", "skipped"] }, "duration_ms": { "type": "integer", "minimum": 0 } }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object", "required": ["severity", "message"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "type": "string", "enum": ["error", "warning", "info"] },
          "tool": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 0 },
          "message": { "type": "string" },
          "fix_available": { "type": "boolean" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": { "type": "object", "required": ["path"], "properties": { "path": { "type": "string" }, "kind": { "type": "string" } } }
    }
  }
}
